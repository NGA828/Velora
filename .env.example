# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.e2b.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://*.e2b.app
HOSPITAL_TIME_ZONE=Africa/Lagos
SQLITE_PATH=backend/db.sqlite3
FRONTEND_URL=http://localhost:5173

# Email (console backend is used locally; set EMAIL_HOST etc. for real SMTP)
# Providers using implicit TLS on port 465: set EMAIL_USE_SSL=true and
# EMAIL_PORT=465 (this automatically disables STARTTLS).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Velora <no-reply@example.org>
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
# Verify delivery with: python manage.py send_test_email you@example.org

# Twilio (calling stays unavailable until configured)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=https://hospital.example.org

# In-app WebRTC media transport.
# STUN is supplied by default. For voice calls between browsers on different
# networks (symmetric NAT, corporate firewalls, mobile carriers) a TURN relay
# is required; set the three TURN values below to enable one. Multiple servers
# can be comma-separated.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=

# Conversational Clinical Assistant (any OpenAI-compatible provider)
#
# Free providers with daily limits far above ~20 messages/day (no credit card):
#   groq        ~30 req/min, ~1,000 req/day      -> https://console.groq.com
#   gemini      ~10 req/min,  ~250-1,500 req/day -> https://aistudio.google.com
#   cerebras    ~1M tokens/day                   -> https://cloud.cerebras.ai
#   mistral     ~1B tokens/month                 -> https://console.mistral.ai
#   sambanova   ~200K tokens/day per model       -> https://cloud.sambanova.ai
#   openrouter  50 req/day (1,000/day after a one-time $10 top-up) -> https://openrouter.ai
#
# Recommended free setup: primary Groq + fallback Gemini = no single rate limit
# can take the assistant down. See docs/FREE_AI_PROVIDERS.md.
AI_PROVIDER=groq
AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# AI_FALLBACK_PROVIDER=gemini
# AI_FALLBACK_MODEL=gemini-2.5-flash

# Legacy DeepSeek (paid) configuration - still supported for existing deployments
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
